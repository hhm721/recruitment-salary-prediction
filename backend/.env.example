# 数据库配置（按本机环境修改）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recruitment_db
DB_USER=root
DB_PASSWORD=your_password_here

# Flask 配置
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# 爬虫基本信息
CRAWL_KEYWORD=人工智能
CRAWL_CITY=北京
CRAWL_PAGES=3

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_ERROR_FILE=error.log
LOG_CLEAN_INTERVAL_MINUTES=30
